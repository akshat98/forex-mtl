@startuml
title Forex Proxy Sequence

actor Client
participant "Local Forex API" as API
participant "Redis Cache" as Cache
participant "One-Frame API" as Upstream

Client -> API: GET /rates?from=USD&to=JPY
API -> API: validate

alt invalid request
  API --> Client: 400 error
else same currency
  API --> Client: 200 price=1
else valid request
  API -> Cache: GET redis key for USD

  alt fresh cache entry exists
    Cache --> API: cached USD->* rates
    API -> API: pick USD->JPY
    API --> Client: 200 rate response
  else cache missing or stale
    API -> Upstream: GET /rates?pair=USDAED&pair=USDAUD&...&pair=USDZAR\nHeader: token=10dc303535874aeccc86a8251e6992f5

    alt upstream success
      Upstream --> API: all USD->* rates
      API -> Cache: SET redis key for USD
      API -> API: pick USD->JPY
      API --> Client: 200 rate response
    else upstream error
      Upstream --> API: error response
      API --> Client: 502/503 error
    end
  end
end

@enduml
